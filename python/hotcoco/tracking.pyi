"""Type stubs for hotcoco.tracking — HOTA, CLEAR, and Identity on MOTChallenge boxes."""

from __future__ import annotations

import os
from typing import Any

import numpy.typing as npt

METRIC_NAMES: list[str]

class TrackingEval:
    """Multi-object tracking evaluation against TrackEval's protocol."""

    def __init__(
        self, benchmark: str | None = None, *, clear_threshold: float = 0.5, identity_threshold: float = 0.5
    ) -> None: ...
    def update(self, name: str, gt: npt.ArrayLike, pred: npt.ArrayLike, *, num_frames: int) -> None: ...
    def update_folders(
        self,
        gt_folder: str | os.PathLike[str],
        pred_folder: str | os.PathLike[str],
        *,
        seqmap: str | os.PathLike[str] | None = None,
    ) -> int: ...
    def merge(self, other: TrackingEval) -> None: ...
    @property
    def benchmark(self) -> str | None: ...
    @property
    def clear_threshold(self) -> float: ...
    @property
    def identity_threshold(self) -> float: ...
    @property
    def stats(self) -> list[float]: ...
    def summarize(self) -> None: ...
    def summary_lines(self) -> list[str]: ...
    def results(self) -> dict[str, Any]: ...
    def sequence_results(self) -> dict[str, dict[str, float | int]]: ...
    def curves(self, sequence: str | None = None) -> dict[str, list[float]]: ...
    def report(self) -> dict[str, Any]: ...
    def reference_deviations(self) -> list[str]: ...
    def provenance(self) -> str: ...
    def __reduce__(self) -> tuple[Any, ...]: ...
    def __getstate__(self) -> bytes: ...
    def __setstate__(self, state: bytes) -> None: ...
