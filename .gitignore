# =============================================================================
# Project-specific
# =============================================================================

# Docs build output
site/

# Claude Code memory
.claude/

# Benchmark / annotation data (large files, not in repo)
/data/

# Test fixtures — generated artifacts only.
#
# `tests/fixtures/adversarial/` is deliberately NOT here: it is a hand-curated
# regression corpus (all-crowd, area boundaries, 1x1 images, boxes outside the
# frame), and a corpus that exists on one machine verifies nothing anywhere else.
# The two `*_expected.json` oracles are tracked for the same reason.
tests/fixtures/parity_failures/
tests/fixtures/.hypothesis/

# uv lock file (transient dev env)
crates/hotcoco-pyo3/uv.lock
external/
.claude.local.md

# Local working directories (specs, scratch notes)
specs/
scratch/

# MCP / plugin artifacts (not part of the project)
node_modules/
package.json
package-lock.json
.mcp.json
.playwright-mcp/
.serena/
.superpowers/
# Working papers — plans, spikes, audits, investigation notes. Local by design:
# they are scratch thinking with a short half-life, not documentation anyone
# should find in the repo. `plans/` is the one place they go — at the repo root,
# outside docs/, so the docs builder can never publish them.
/plans/
docs/notes/

# Generated reports
report.pdf

# Session working notes (PR bodies, review write-ups) — same rationale as
# `plans/`: short half-life, not documentation anyone should find in the repo.
/.plans/
/.reports/
/.temp/
